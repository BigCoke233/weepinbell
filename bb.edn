{:paths ["scripts" "scripts/ci"]
 :deps-resolver :jvm
 :deps {org.clj-commons/hickory {:mvn/version "0.7.7"}}
 :tasks
 {build (shell "lein" "uberjar")
  sign (do
         (shell "sh" "-c" "sha256sum target/weepinbell-v*.jar > SHA256SUMS")
         (let [key (or (System/getenv "WEEPINBELL_SIGN_KEY")
                       (str (System/getProperty "user.home")
                            "/.ssh/id_ecdsa_sk_rk"))]
           (shell "ssh-keygen" "-Y" "sign" "-f" key "-n" "file" "SHA256SUMS"))
         (println "generated SHA256SUMS and SHA256SUMS.sig"))
  verify (do
           (println "Verifying SSH key signatures")
           (shell "sh" "-c"
                  "ssh-keygen -Y verify -f allowed_signers -I hi@eltr.ac -n file -s SHA256SUMS.sig < SHA256SUMS")
           (println "Verifying checksum")
           (shell "sha256sum -c SHA256SUMS"))}}
