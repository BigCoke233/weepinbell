{:paths ["scripts"]
 :tasks {treeshake {:doc "Treeshake pico.min.css"
                    :requires ([treeshake :as ts])
                    :task (ts/treeshake-pico)}
         build {:doc "Build and bundle squint to JS"
                :task (shell "npm run build")
                :depends [treeshake]}
         watch {:doc "Watch for changes and build."
                :task (doall (pmap shell ["npm run compile:watch"
                                          "npm run bundle:watch"]))}}}

